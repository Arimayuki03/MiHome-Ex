# ============================================
# MiHome-Ex .gitignore
# ============================================

# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- Python 缓存 ----
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ---- 构建产物 ----
*.egg-info/
*.egg
dist/
build/
build_nuitka/
*.spec

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 项目特定：认证与缓存 ----
# 扫码登录后的认证文件包含账号凭据，绝不提交
auth.json

# 本地设备缓存（包含设备列表、token 等）
devices_cache.json
.mihome_cache/

# 设备图标缓存（model -> 图标 URL 映射与图片文件）
device_icons.json
icons/

# 用户个性化配置（每个人不同）
tray.json
workbench.json
settings.json
# 原子写的临时残留（正常流程会被 os.replace 消费）
*.json.tmp

# ---- 环境秘密 ----
.env
.env.*
.envrc
# 公开的模板仍应入库
!.env.example
!.env.*.example

# ---- 历史数据库 / WAL / SHM ----
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# ---- 备份 / 转储 ----
*.bak
*.backup
*.dump
*.dmp

# ---- 私钥与私钥导出格式 ----
# 不忽略 *.pem：certifi 等公开 CA 包需要正常入库
*.key
*.p12
*.pfx
*.p8
*.ppk
*.jks
*.keystore
id_rsa
id_ecdsa
id_ed25519
id_dsa

# ---- 日志 ----
*.log
logs/

# ---- 测试覆盖率 ----
.coverage
htmlcov/
.pytest_cache/

# ---- 安装包构建输出 ----
installer/Output/

# ---- Mimosa 安全钩子的本地状态（不入库） ----
.mimosa/
